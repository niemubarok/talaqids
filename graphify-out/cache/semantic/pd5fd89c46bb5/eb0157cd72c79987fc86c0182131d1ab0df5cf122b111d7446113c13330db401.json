{"nodes": [{"id": "agents_skills_mobile_app_ui_design_skill_skill_guide", "label": "Mobile App UI/UX Design Skill Guide", "file_type": "document", "source_file": ".agents/skills/mobile-app-ui-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_mobile_app_ui_design_skill_core_philosophy", "label": "Core Design Philosophy (Intentionality)", "file_type": "rationale", "source_file": ".agents/skills/mobile-app-ui-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Great mobile UI is not about flashiness but intentionality: every pixel, spacing value, and color must serve the user and the primary goal, making interfaces feel smooth, personal, and alive rather than merely functional."}, {"id": "agents_skills_mobile_app_ui_design_skill_design_process", "label": "5-Step Mobile Design Process", "file_type": "concept", "source_file": ".agents/skills/mobile-app-ui-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_mobile_app_ui_design_skill_ux_lens", "label": "Structure First (UX Lens)", "file_type": "concept", "source_file": ".agents/skills/mobile-app-ui-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_mobile_app_ui_design_skill_thumb_zone", "label": "Thumb Zone", "file_type": "rationale", "source_file": ".agents/skills/mobile-app-ui-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Primary actions belong in the bottom third of the screen because that is where thumbs comfortably reach, minimizing interaction cost on one-handed mobile use."}, {"id": "agents_skills_mobile_app_ui_design_skill_f_pattern", "label": "F-Pattern Reading Order", "file_type": "concept", "source_file": ".agents/skills/mobile-app-ui-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_mobile_app_ui_design_skill_typography_hierarchy", "label": "Typography Hierarchy Rule", "file_type": "rationale", "source_file": ".agents/skills/mobile-app-ui-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Limiting to one font family, four sizes, and two weights (using size, weight, and opacity for hierarchy) prevents visual noise and keeps scanning effortless."}, {"id": "agents_skills_mobile_app_ui_design_skill_color_system_60_30_10", "label": "60/30/10 Color Rule", "file_type": "rationale", "source_file": ".agents/skills/mobile-app-ui-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "60% neutral base, 30% complementary, 10% accent reserves strong color for meaningful moments (CTAs, key indicators); overusing accent color kills hierarchy."}, {"id": "agents_skills_mobile_app_ui_design_skill_spacing_8_point_grid", "label": "8-Point Grid Spacing System", "file_type": "rationale", "source_file": ".agents/skills/mobile-app-ui-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All spacing divisible by 8 or 4 plus relationship-based spacing (2x multiplier between groups) creates rhythm and encodes grouping without borders."}, {"id": "agents_skills_mobile_app_ui_design_skill_shadows", "label": "Soft Shadow Rules", "file_type": "concept", "source_file": ".agents/skills/mobile-app-ui-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_mobile_app_ui_design_skill_visual_cues_imagery", "label": "Visual Cues and Imagery", "file