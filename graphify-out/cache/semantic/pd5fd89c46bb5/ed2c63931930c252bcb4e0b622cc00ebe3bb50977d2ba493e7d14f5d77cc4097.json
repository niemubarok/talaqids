{"nodes": [{"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions", "label": "Industry Conventions & Emotional Design Reference", "file_type": "document", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exists as the deeper reference layer the main skill defers to, covering per-industry visual languages, emotional design psychology, and a client-facing process."}, {"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions_ai_tech_language", "label": "AI/Tech Design Language", "file_type": "concept", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Soft gradients, moving elements, glowing dimensionality and smooth animations communicate intelligence; ethereal accents on dark or light themes."}, {"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions_crypto_web3_language", "label": "Crypto/Web3 Design Language", "file_type": "concept", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neon colors, bold typography, dark backgrounds and geometric shapes. Phantom's lesson: polish builds trust, so visual details, motion and transitions are core product features rather than fluff."}, {"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions_finance_banking_language", "label": "Finance/Banking Design Language", "file_type": "concept", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blue-dominant palettes signal trust, stability and reliability; generous white space and conservative typography make it feel safe. Revolut's lesson: tactile interactions (draggable charts, 3D card flips) convert basic features into premium experiences."}, {"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions_health_wellness_language", "label": "Health/Wellness Design Language", "file_type": "concept", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bright approachable colors reduce anxiety, friendly illustrations and warm micro-interactions soften the tone, and non-intimidating onboarding matters most. Ahead (Apple Design Award) lesson: guide users kindly and build the peak as a personalized insight moment."}, {"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions_sleep_meditation_language", "label": "Sleep/Meditation Design Language", "file_type": "concept", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Purple and deep blue tones, minimal UI, soft transitions and ambient low-contrast surfaces support calm rather than stimulation."}, {"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions_education_learning_language", "label": "Education/Learning Design Language", "file_type": "concept", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bright playful palettes and character-driven personality. Duolingo's lesson is quantitative: character animations plus emotional feedback loops doubled DAUs from 14.2M to 34M+ in two years."}, {"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions_fitness_language", "label": "Fitness Design Language", "file_type": "concept", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Energetic colors, bold typography and progress-focused visual momentum, with UI complexity adapted to user stage (new, returning, power user)."}, {"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions_productivity_language", "label": "Productivity Design Language", "file_type": "concept", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clean minimal yet information-dense layouts, strong grids and consistent spacing, quick actions and keyboard shortcuts for power users."}, {"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions_ecommerce_food_language", "label": "E-commerce/Food Design Language", "file_type": "concept", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High-quality product photography, prominent CTAs and frictionless checkout, backed by trust signals such as reviews, ratings and delivery estimates."}, {"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions_peak_end_rule", "label": "Peak-End Rule", "file_type": "rationale", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The brain does not store an experience as a whole; it compresses it into the most intense moment (peak) and the final impression (end). Disney parks are cited: 70% of visitors return because of remembered moments, not a flawless day. Applied to apps by mapping the flow, designing ONE 'holy dang' peak after core-task completion or milestone, always giving closure at the end, and reducing negative peaks at wait screens, errors and long forms (using delays as content opportunities)."}, {"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions_emotional_feedback_loops", "label": "Emotional Feedback Loops", "file_type": "rationale", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Actions should return emotional rather than purely functional feedback: encouragement and character reactions instead of a green check, gentle personality-driven correction instead of a red X, proportional celebration for milestones, and motion-based momentum visualization for progress. The stated reason is that emotional feedback is retained where functional feedback is forgotten."}, {"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions_trojan_horse", "label": "The Trojan Horse (Hide Complexity in Familiar Interfaces)", "file_type": "concept", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spotify principle: wrap sophisticated features in UI patterns users already know, because users do not want to interact with algorithms - they want experiences that feel natural."}, {"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions_vanity_mirror", "label": "The Vanity Mirror (Sharing as Identity)", "file_type": "concept", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spotify principle: celebrate who users are, not what they did in your app. Personal insights should be meaningful enough that sharing feels like self-expression ('You're a night owl...' beats 'You completed 25 tasks')."}, {"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions_comfort_trap", "label": "The Comfort Trap (Consistency as a Moat)", "file_type": "concept", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spotify principle: every interaction follows the same logic so predictable patterns become second nature, raising switching costs. Consistency is framed as habit formation and defensibility, not aesthetics."}, {"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions_client_design_process", "label": "4-Phase Client/Product Design Process", "file_type": "concept", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discovery (mood boards by vibe, 3-5 directions) -> UI direction (visual only, client mixes button/typography/cards from options) -> UX structure (brain dump then MVP 3-5 screens, wireframes) -> combine. Deliberately finalizes the visual direction before wireframing so stakeholders are never surprised late."}, {"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions_ui_lens_vs_ux_lens", "label": "UI Lens vs UX Lens Separation", "file_type": "rationale", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI lens asks how colors work together, what emotions they evoke, spacing, typography and hierarchy; UX lens asks where the search bar is, whether tap targets are big enough, how many steps a core task takes, and what can be eliminated. Mixing the lenses during research corrupts both, so inspiration is gathered separately."}, {"id": "kiro_skills_mobile_app_ui_design_references_industry_conventions_daniel_kahneman", "label": "Daniel Kahneman (Nobel Prize Peak-End Research)", "file_type": "concept", "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cited as the authority behind the Peak-End Rule, which is what licenses the whole emotion step of the skill."}], "edges": [{"source": "kiro_skills_mobile_app_ui_design_references_industry_conventions", "target": "kiro_skills_mobile_app_ui_design_references_industry_conventions_ai_tech_language", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "weight": 1.0}, {"source": "kiro_skills_mobile_app_ui_design_references_industry_conventions", "target": "kiro_skills_mobile_app_ui_design_references_industry_conventions_crypto_web3_language", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "weight": 1.0}, {"source": "kiro_skills_mobile_app_ui_design_references_industry_conventions", "target": "kiro_skills_mobile_app_ui_design_references_industry_conventions_finance_banking_language", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".kiro/skills/mobile-app-ui-design/references/industry-conventions.md", "source_location": null, "weight": 1.0}, {"source": "kiro_skills_mobile_app_ui_design_references_industry_conventions", "target": "kiro_skills_mobile_app_ui_design_references_industry_conventions_hea